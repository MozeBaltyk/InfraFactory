set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

ENV := env_var_or_default("ENV", "lab")
ENV_TFVARS_PATH := "../../env/AZ/" + ENV + ".tfvars"

[private]
_workspace:
    @tofu workspace select {{ ENV }} || tofu workspace new {{ ENV }}

validate:
    @tofu init -backend=false
    @tofu validate

plan NAME='':
    @tofu init
    @just _workspace
    @name="{{ NAME }}"; \
      target_args=(); \
      if test -n "$name"; then \
        case "$name" in \
          *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
        esac; \
        target_args=(-target="azurerm_linux_virtual_machine.vms[\"$name\"]"); \
      fi; \
      tofu plan -var-file={{ ENV_TFVARS_PATH }} "${target_args[@]}"

deploy NAME='':
    @tofu init
    @just _workspace
    @name="{{ NAME }}"; \
      target_args=(); \
      if test -n "$name"; then \
        case "$name" in \
          *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
        esac; \
        target_args=(-target="azurerm_linux_virtual_machine.vms[\"$name\"]"); \
      fi; \
      tofu apply -auto-approve -var-file={{ ENV_TFVARS_PATH }} "${target_args[@]}"

# Force rebuild one VM instance
replace NAME:
    @name="{{ NAME }}"; \
      case "$name" in \
        *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
      esac; \
      tofu init; \
      just _workspace; \
      tofu apply -var-file={{ ENV_TFVARS_PATH }} -target="azurerm_linux_virtual_machine.vms[\"$name\"]" -replace="azurerm_linux_virtual_machine.vms[\"$name\"]"

destroy:
    @tofu init
    @just _workspace
    @tofu destroy -auto-approve -var-file={{ ENV_TFVARS_PATH }}
