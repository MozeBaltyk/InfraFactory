locals {
  common_cloudinit = {
    for vm in local.all_vms_map :
    vm.name => templatefile(
      "${path.module}/../shared/cloud-init/${var.cluster.cloud_init_selected}/cloud_init.cfg.tftpl",
      {
        ## Base OS
        os_name  = local.os.os_name
        hostname = vm.name
        fqdn     = "${vm.name}.${local.subdomain}"
        domain   = local.subdomain

        ## Node
        node_role     = vm.role
        node_username = var.cluster.username
        timezone      = var.cluster.timezone
        clusterid     = var.cluster.id

        ## Base OS upgrade
        package_upgrade_enabled = var.cluster.package_upgrade_enabled

        ## SSH
        public_key = tls_private_key.global_key.public_key_openssh

        ## Networking
        current_private_ip = vm.private_ip

        is_first_master = (
          vm.role == "master" &&
          vm.name == local.first_master_name
        )

        first_master_ip   = local.master_details[0].private_ip
        first_master_fqdn = local.first_master_fqdn

        ## Join endpoint
        cluster_join_endpoint = local.master_details[0].private_ip

        ## Disks
        extra_disks = try(local.vm_disks[vm.name], [])

        # Extra packages
        extra_packages = var.extra_packages

        #################################################
        # K3S
        #################################################

        k3s_token   = local.cluster_token
        k3s_version = var.k3s.version

        k3s_tls_sans = distinct(compact(concat(
          var.k3s.tls_sans,
          [local.master_details[0].private_ip],
          [local.first_master_fqdn],
          [for master in local.master_details : "${master.name}.${local.subdomain}"]
        )))

        k3s_etcd_enabled           = var.k3s.etcd_enabled
        k3s_traefik_enabled        = var.k3s.traefik_enabled
        k3s_servicelb_enabled      = var.k3s.servicelb_enabled
        k3s_local_storage_enabled  = var.k3s.local_storage_enabled
        k3s_metrics_server_enabled = var.k3s.metrics_server_enabled
        k3s_flannel_enabled        = var.k3s.flannel_enabled

        #################################################
        # RKE2
        #################################################

        rke2_token   = local.cluster_token
        rke2_version = var.rke2.version

        rke2_tls_sans = distinct(compact(concat(
          var.rke2.tls_sans,
          [local.master_details[0].private_ip],
          [local.first_master_fqdn],
          [for master in local.master_details : "${master.name}.${local.subdomain}"]
        )))

        rke2_etcd_enabled             = var.rke2.etcd_enabled
        rke2_ingress_nginx_enabled    = var.rke2.ingress_nginx_enabled
        rke2_metrics_server_enabled   = var.rke2.metrics_server_enabled
        rke2_cni                      = var.rke2.cni
        rke2_ingress_type             = var.rke2.ingress_type
        rke2_kube_proxy_enabled       = try(var.rke2.kube_proxy_enabled, true)
        rke2_cilium_hubble_enabled    = try(var.rke2.cilium.hubble_enabled, false)
        rke2_cilium_operator_replicas = try(var.rke2.cilium.operator_replicas, 1)

        #################################################
        # Ansible Pull
        #################################################

        ansible_pull_repo     = replace(try(var.ansible.pull.repo, ""), "https://", "")
        ansible_pull_branch   = try(var.ansible.pull.branch, "main")
        ansible_pull_playbook = try(var.ansible.pull.playbook, "local.yml")
        ansible_pull_token    = try(var.ansible.pull.token, null)
        ansible_pull_timer    = try(var.ansible.pull.timer, null)
      }
    )
  }

  ##
  ## OVH static private NIC config and first-boot preflight
  ##
  ## Let OVH/OpenStack metadata own first-boot public networking. OVH's instance
  ## resource does not expose a separate cloud-init network_config argument, and
  ## overriding top-level `network:` in user-data can break public SSH. Instead,
  ## write an additional netplan file for the private NIC for persistence. The
  ## Kubernetes installers need the private address before they start, so a
  ## fail-fast preflight script configures ens4 with non-disruptive `ip`
  ## commands before k3s/rke2 installation, or at the start of runcmd for the
  ## default cloud-init mode. Do not run `netplan apply` here: public networking
  ## remains metadata-owned.

  private_prefix = split("/", local.private_cidr)[1]

  common_cloudinit_docs = {
    for name, content in local.common_cloudinit :
    name => yamldecode(content)
  }

  common_cloudinit_runcmd = {
    for name, doc in local.common_cloudinit_docs :
    name => try(doc.runcmd, [])
  }

  cluster_install_runcmd_indexes = {
    for name, commands in local.common_cloudinit_runcmd :
    name => [
      for idx, command in commands : idx
      if contains([
        "/usr/local/bin/k3s-install.sh",
        "/usr/local/bin/rke2-install.sh"
      ], try(tolist(command)[0], ""))
    ]
  }

  cluster_install_runcmd_index = {
    for name, indexes in local.cluster_install_runcmd_indexes :
    name => try(indexes[0], 0)
  }

  ovh_private_netplan_yaml = {
    for name, vm in local.all_vms_map :
    name => "# Managed by InfraFactory: configure OVH private NIC only.\n${yamlencode({
      network = {
        version = 2
        ethernets = {
          ens4 = {
            dhcp4     = false
            optional  = true
            addresses = ["${vm.private_ip}/${local.private_prefix}"]
          }
        }
      }
    })}"
  }

  ovh_private_network_preflight_script = {
    for name, vm in local.all_vms_map :
    name => <<-EOT
      #!/bin/bash
      set -euo pipefail

      IFACE="ens4"
      PRIVATE_IP="${vm.private_ip}"
      PREFIX="${local.private_prefix}"
      CIDR="$${PRIVATE_IP}/$${PREFIX}"
      TIMEOUT_SECONDS=120
      DEADLINE=$${SECONDS}
      DEADLINE=$((DEADLINE + TIMEOUT_SECONDS))

      fail() {
        echo "ERROR: OVH private network preflight failed: $${1:-unknown error}" >&2
        ip -br link show dev "$${IFACE}" >&2 || true
        ip -4 addr show dev "$${IFACE}" >&2 || true
        ip route show default >&2 || true
        exit 1
      }

      echo "Waiting for OVH private interface $${IFACE}"
      while ! ip link show dev "$${IFACE}" >/dev/null 2>&1; do
        if [ "$${SECONDS}" -ge "$${DEADLINE}" ]; then
          fail "interface $${IFACE} did not appear within $${TIMEOUT_SECONDS}s"
        fi
        sleep 2
      done

      echo "Bringing $${IFACE} up and assigning $${CIDR}"
      ip link set dev "$${IFACE}" up || fail "unable to bring $${IFACE} up"

      while true; do
        OPERSTATE="$(cat "/sys/class/net/$${IFACE}/operstate" 2>/dev/null || true)"
        if [ "$${OPERSTATE}" = "up" ] || [ "$${OPERSTATE}" = "unknown" ]; then
          break
        fi
        if [ "$${SECONDS}" -ge "$${DEADLINE}" ]; then
          fail "interface $${IFACE} did not become usable within $${TIMEOUT_SECONDS}s (operstate=$${OPERSTATE})"
        fi
        ip link set dev "$${IFACE}" up || true
        sleep 2
      done

      ip addr replace "$${CIDR}" dev "$${IFACE}" || fail "unable to assign $${CIDR} to $${IFACE}"

      if ! ip -o -4 addr show dev "$${IFACE}" | grep -Eq "[[:space:]]$${PRIVATE_IP}/$${PREFIX}[[:space:]]"; then
        fail "address $${CIDR} is not present on $${IFACE}"
      fi

      while ip route show default dev "$${IFACE}" | grep -q '^default'; do
        ip route del default dev "$${IFACE}" || fail "unable to remove default route from $${IFACE}"
      done

      if ip route show default dev "$${IFACE}" | grep -q '^default'; then
        fail "default route must not use $${IFACE}"
      fi

      echo "OVH private network preflight passed for $${IFACE} with $${CIDR}"
    EOT
  }

  cloudinit_user_data = {
    for name, vm in local.all_vms_map :
    name => "#cloud-config\n${yamlencode(merge(
      local.common_cloudinit_docs[name],
      {
        write_files = concat(
          try(local.common_cloudinit_docs[name].write_files, []),
          [
            {
              path        = "/etc/netplan/99-infrafactory-private.yaml"
              permissions = "0644"
              owner       = "root:root"
              content     = local.ovh_private_netplan_yaml[name]
            },
            {
              path        = "/usr/local/bin/infrafactory-private-network-preflight.sh"
              permissions = "0755"
              owner       = "root:root"
              content     = local.ovh_private_network_preflight_script[name]
            }
          ]
        )

        runcmd = concat(
          slice(local.common_cloudinit_runcmd[name], 0, local.cluster_install_runcmd_index[name]),
          [["/usr/local/bin/infrafactory-private-network-preflight.sh"]],
          slice(local.common_cloudinit_runcmd[name], local.cluster_install_runcmd_index[name], length(local.common_cloudinit_runcmd[name]))
        )
      }
    ))}"
  }
}

resource "local_file" "ansible_config" {
  filename = "${local.env_path}/ansible.cfg"
  content  = <<-EOT
[defaults]
remote_user = ${var.cluster.username}
inventory =  ./hosts.ini
roles_path = ../../../ansible/roles
host_key_checking = false
display_skipped_hosts = false
deprecation_warnings = false
force_color       = True
stdout_callback   = yaml
private_key_file = ./.key.private
EOT

  depends_on = [null_resource.env_directory]
}
