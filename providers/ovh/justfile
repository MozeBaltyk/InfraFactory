# Thin router: the OVH cluster stack lives in clusters/ (independent root
# module) and the standalone bastion in bastion/. An untargeted deploy runs
# the complete safe workflow; plan/destroy/validate remain cluster operations.
# (PROJECT/ENV/NAME/STALE flow through as environment/args to the sub-module.)

mod clusters "clusters/justfile"
mod bastion "bastion/justfile"

# Fail-closed preflight: refuse cross-cluster VLAN/CIDR/state-identity violations
# (the OVH private-network identity is (project, region, vlan_id) — duplicates are fatal).
preflight:
    @python3 ../../scripts/ovh/config-status.py --preflight "$(cd ../.. && pwd)" "$PROJECT"

validate:
    @just clusters::validate

backend-init:
    @just clusters::backend-init

backend-status:
    @just clusters::backend-status

backend-migrate FROM TO:
    @just clusters::backend-migrate {{ quote(FROM) }} {{ quote(TO) }}

plan NAME='':
    @just clusters::plan {{ quote(NAME) }}

# Run the complete workflow unless NAME explicitly targets one cluster VM.
deploy NAME='':
    @if test -n {{ quote(NAME) }}; then just cluster-deploy {{ quote(NAME) }}; else just provision; fi

# Advanced cluster-only apply plus best-effort bastion artifact sync.
cluster-deploy NAME='':
    @just clusters::deploy {{ quote(NAME) }}
    @bash ../../scripts/sync-guests-info.sh || true

# Complete paid workflow: bootstrap, bastion deploy/converge, cluster-only deploy.
provision:
    @just preflight
    @just clusters::bootstrap
    @just bastion::deploy
    @key="$(cd ../.. && pwd)/env/OVH/${PROJECT}/bastion/${BASTION_ENV:-bastion}/.key.private"; \
      test -f "$key" || { echo "Generated bastion key missing after deploy: $key" >&2; exit 1; }; \
      just bastion::converge "$key"
    @just cluster-deploy

# Deploy only the cluster private network + SSH keys (bastion attach prerequisite).
bootstrap:
    @just preflight
    @just clusters::bootstrap

# Force rebuild one cluster VM (first controller refused, see clusters recipe).
replace NAME:
    @just clusters::replace {{ quote(NAME) }}

# Fail fast when the gateway's centralized SNAT port is DOWN (no egress).
check-gateway:
    @just clusters::check-gateway

# Recreate a broken cluster gateway through the configured backend.
replace-gateway:
    @just clusters::replace-gateway

# Destroy on the provider. Pass STALE=true to skip the refresh phase.
# Fails closed if the bastion still references this cluster (its port would block subnet deletion).
destroy STALE='':
    @python3 ../../scripts/ovh/config-status.py --destroy "$ENV" "$(cd ../.. && pwd)" "$PROJECT"
    @just clusters::destroy {{ quote(STALE) }}

# Standalone bastion stack (explicit: never the default target).
bastion-validate:
    @just bastion::validate

bastion-backend-init:
    @just bastion::backend-init

bastion-backend-status:
    @just bastion::backend-status

bastion-backend-migrate FROM TO:
    @just bastion::backend-migrate {{ quote(FROM) }} {{ quote(TO) }}

bastion-plan:
    @just bastion::plan

bastion-deploy:
    @just bastion::deploy

# VM only (ports + fixed IPs kept); full teardown otherwise.
bastion-destroy-vm STALE='':
    @just bastion::destroy-vm {{ quote(STALE) }}

bastion-destroy-all STALE='':
    @just bastion::destroy-all {{ quote(STALE) }}
