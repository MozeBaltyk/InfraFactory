set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

ENV := env_var_or_default("ENV", "lab")
ENV_TFVARS_PATH := "../../env/OVH/" + ENV + ".tfvars"
FLOATING_IP_CAPTURE_PATH := "../../env/OVH/" + ENV + "/.ovh-floating-ip.json"
FLOATING_IP_HELPER := "./floating_ip_cleanup.py"

[private]
_workspace:
    @tofu workspace select {{ ENV }} || tofu workspace new {{ ENV }}

validate:
    @tofu init -backend=false
    @tofu validate

plan:
    @tofu init
    @just _workspace
    @tofu plan -var-file={{ ENV_TFVARS_PATH }}

deploy:
    @tofu init
    @just _workspace
    @tofu apply -auto-approve -var-file={{ ENV_TFVARS_PATH }}

capture-floating-ip:
    @tofu init
    @just _workspace
    @python3 {{ FLOATING_IP_HELPER }} capture --workspace {{ ENV }} --capture-file {{ FLOATING_IP_CAPTURE_PATH }}

cleanup-floating-ip:
    @if [ -f {{ FLOATING_IP_CAPTURE_PATH }} ]; then \
        python3 {{ FLOATING_IP_HELPER }} cleanup \
          --tfvars {{ ENV_TFVARS_PATH }} \
          --capture-file {{ FLOATING_IP_CAPTURE_PATH }} \
          --allow-detach; \
    else \
        echo "No OVH floating IP capture file at {{ FLOATING_IP_CAPTURE_PATH }}; skipping cleanup."; \
    fi

destroy:
    @tofu init
    @just _workspace
    @python3 {{ FLOATING_IP_HELPER }} capture --workspace {{ ENV }} --capture-file {{ FLOATING_IP_CAPTURE_PATH }}
    @bash -c '\
        set +e; \
        set -o pipefail; \
        destroy_log="$(mktemp)"; \
        tofu destroy -auto-approve -var-file={{ ENV_TFVARS_PATH }} 2>&1 | tee "$destroy_log"; \
        destroy_status=$?; \
        if [ "$destroy_status" -ne 0 ] && grep -Eiq "Get .*/sshkey/|Delete .*/sshkey/|Keypair .* not found|key not found" "$destroy_log"; then \
          echo "OVH SSH key is already absent; removing ovh_cloud_project_ssh_key.cluster from state and retrying destroy."; \
          tofu state rm ovh_cloud_project_ssh_key.cluster || true; \
          tofu destroy -auto-approve -var-file={{ ENV_TFVARS_PATH }}; \
          destroy_status=$?; \
        fi; \
        rm -f "$destroy_log"; \
        if [ -f {{ FLOATING_IP_CAPTURE_PATH }} ]; then \
          python3 {{ FLOATING_IP_HELPER }} cleanup \
            --tfvars {{ ENV_TFVARS_PATH }} \
            --capture-file {{ FLOATING_IP_CAPTURE_PATH }} \
            --allow-detach; \
          cleanup_status=$?; \
        else \
          echo "No OVH floating IP capture file at {{ FLOATING_IP_CAPTURE_PATH }}; skipping cleanup."; \
          cleanup_status=0; \
        fi; \
        if [ "$destroy_status" -ne 0 ]; then \
          exit "$destroy_status"; \
        fi; \
        exit "$cleanup_status" \
    '
