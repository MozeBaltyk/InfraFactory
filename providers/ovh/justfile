set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

ENV := env_var_or_default("ENV", "lab")
ENV_TFVARS_PATH := "../../env/OVH/" + ENV + ".tfvars"

[private]
_source-openrc:
    @is_talos=0; \
      if test -f {{ ENV_TFVARS_PATH }}; then \
        while IFS= read -r line; do \
          case "$line" in *cloud_init_selected*'='*'"talos"'*) is_talos=1; break ;; esac; \
        done < {{ ENV_TFVARS_PATH }}; \
      fi; \
      if test "$is_talos" = 0; then exit 0; fi; \
      for openrc in "${OPENRC:-}" ../../env/OVH/{{ ENV }}.openrc.local ../../env/OVH/{{ ENV }}.openrc ../../env/OVH/openrc.sh; do \
        if test -n "$openrc" && test -f "$openrc"; then printf '%s\n' "$openrc"; exit 0; fi; \
      done; \
      exit 0

[private]
_workspace:
    @tofu workspace select {{ ENV }} || tofu workspace new {{ ENV }}

validate:
    @tofu init -backend=false
    @tofu validate

plan NAME='':
    @tofu init
    @just _workspace
    @openrc="$(just _source-openrc)"; \
      if test -z "${OS_AUTH_URL:-}${OS_CLOUD:-}" && test -n "$openrc"; then set -a; . "$openrc"; set +a; fi; \
      name="{{ NAME }}"; \
      target_args=(); \
      if test -n "$name"; then \
        case "$name" in \
          *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
        esac; \
        target_args=(-target="ovh_cloud_project_instance.vms[\"$name\"]"); \
      fi; \
      tofu plan -var-file={{ ENV_TFVARS_PATH }} "${target_args[@]}"

deploy NAME='':
    @tofu init
    @just _workspace
    @openrc="$(just _source-openrc)"; \
      if test -z "${OS_AUTH_URL:-}${OS_CLOUD:-}" && test -n "$openrc"; then set -a; . "$openrc"; set +a; fi; \
      name="{{ NAME }}"; \
      target_args=(); \
      if test -n "$name"; then \
        case "$name" in \
          *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
        esac; \
        target_args=(-target="ovh_cloud_project_instance.vms[\"$name\"]"); \
      fi; \
      tofu apply -auto-approve -var-file={{ ENV_TFVARS_PATH }} "${target_args[@]}"

# Force rebuild one VM instance
replace NAME:
    @name="{{ NAME }}"; \
      case "$name" in \
        *[!A-Za-z0-9._-]*|'') echo "Invalid VM name: $name" >&2; exit 1 ;; \
      esac; \
      tofu init; \
      just _workspace; \
      tofu apply -var-file={{ ENV_TFVARS_PATH }} -target="ovh_cloud_project_instance.vms[\"$name\"]" -replace="ovh_cloud_project_instance.vms[\"$name\"]"

# Destroy on the provider. Pass STALE=true to skip the refresh phase
# (use when machines are broken/stale and refresh hangs on dead nodes).
destroy STALE='':
    @tofu init
    @just _workspace
    @refresh=""; \
      if test -n "{{ STALE }}"; then refresh="-refresh=false"; fi; \
      openrc="$(just _source-openrc)"; \
      if test -z "${OS_AUTH_URL:-}${OS_CLOUD:-}" && test -n "$openrc"; then set -a; . "$openrc"; set +a; fi; \
      OVH_APPLICATION_KEY="$(sed -n 's/^[[:space:]]*ovh_application_key[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' {{ ENV_TFVARS_PATH }})" \
      OVH_APPLICATION_SECRET="$(sed -n 's/^[[:space:]]*ovh_application_secret[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' {{ ENV_TFVARS_PATH }})" \
      OVH_CONSUMER_KEY="$(sed -n 's/^[[:space:]]*ovh_consumer_key[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' {{ ENV_TFVARS_PATH }})" \
      tofu destroy -auto-approve $refresh -var-file={{ ENV_TFVARS_PATH }}
