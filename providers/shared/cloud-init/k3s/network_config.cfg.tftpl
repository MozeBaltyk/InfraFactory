network:
  version: 2
  ethernets:
%{ if public_iface != null ~}
    # Optional second NIC (e.g. OVH public interface): plain DHCP, keeps the
    # default route. Omitted unless the caller passes public_iface, so
    # existing single-NIC callers render exactly as before.
    ${public_iface}:
      match:
        name: "${public_iface}"
      optional: true
      dhcp4: true
%{ endif ~}
    ${interface_id}:
      match:
        name: "${interface_match_name}"
%{ if try(interface_optional, false) ~}
      optional: true
%{ endif ~}
%{ if use_dhcp ~}
      dhcp4: true
%{ if !accept_dhcp_routes || !accept_dhcp_dns ~}
      dhcp4-overrides:
%{ if !accept_dhcp_routes ~}
        use-routes: false
%{ endif ~}
%{ if !accept_dhcp_dns ~}
        use-dns: false
%{ endif ~}
%{ endif ~}
%{ else ~}
      dhcp4: false
      addresses:
        - ${ip_address}/${cidr_prefix}
%{ endif ~}
%{ if network_gateway != null && network_gateway != "" ~}
      routes:
        - to: default
          via: ${network_gateway}
%{ else ~}
%{ if try(emit_empty_routes, false) ~}
      routes: []
%{ endif ~}
%{ endif ~}
%{ if dns_servers != null && dns_servers != "" ~}
      nameservers:
        addresses: [${dns_servers}]
        search: []  # no cluster search domain: nodes address each other by full FQDN (SIMPL/k8s)
%{ endif ~}
