#cloud-config

timezone: ${timezone}

hostname: ${hostname}
fqdn: ${fqdn}

manage_etc_hosts: true

users:
  - name: ${node_username}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    gecos: ${node_username} User
    groups: users,sudo
    homedir: /home/${node_username}
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${public_key}

package_update: true
package_upgrade: ${package_upgrade_enabled}
package_reboot_if_required: true

packages:
  - curl
  - bash-completion
  - qemu-guest-agent
%{ if ansible_pull_repo != null && ansible_pull_repo != "" ~}
  - git
  - tar
  - unzip
%{ endif ~}
%{ if length(extra_packages) > 0 }
%{ for p in extra_packages ~}
  - ${p}
%{ endfor ~}
%{ endif }
%{ if length(nfs_client_mounts) > 0 ~}
  - nfs-common
%{ endif ~}

write_files:
%{ if length(object_storage_credentials) > 0 ~}
%{ for c in object_storage_credentials ~}
  - path: /etc/infrafactory/object-storage/${c.name}.env
    permissions: "0600"
    content: |
      AWS_ACCESS_KEY_ID=${c.access_key_id}
      AWS_SECRET_ACCESS_KEY=${c.secret_access_key}
      AWS_DEFAULT_REGION=${c.region}
      AWS_ENDPOINT_URL=https://${c.endpoint}
      S3_BUCKET=${c.bucket}
%{ endfor ~}
%{ endif ~}
  - path: /etc/sysctl.d/99-kubernetes.conf
    content: |
      fs.inotify.max_user_watches=1048576
      fs.inotify.max_user_instances=8192
      fs.file-max=2097152
      net.ipv4.ip_forward=1
      net.bridge.bridge-nf-call-iptables=1
      net.bridge.bridge-nf-call-ip6tables=1

  - path: /etc/modules-load.d/kubernetes.conf
    content: |
      overlay
      br_netfilter

  - path: /etc/rancher/rke2/config.yaml
    permissions: "0640"
    content: |
%{ if !is_first_master ~}
      server: "https://${first_master_ip}:9345"
%{ endif ~}
      token: "${rke2_token}"
%{ if rke2_data_dir != null && rke2_data_dir != "" ~}
      data-dir: "${rke2_data_dir}"
%{ endif ~}
%{ if current_private_ip != null && current_private_ip != "" ~}
      node-ip: ${current_private_ip}
%{ if node_role == "master" ~}
      advertise-address: ${current_private_ip}
%{ endif ~}
%{ endif ~}
      write-kubeconfig-mode: '0600'
%{ if length(rke2_tls_sans) > 0 ~}
      tls-san:
%{ for san in rke2_tls_sans ~}
        - ${san}
%{ endfor ~}
%{ endif ~}
%{ if !rke2_etcd_enabled ~}
      disable-etcd: true
%{ endif ~}
%{ if rke2_cni != null && rke2_cni != "" ~}
      cni: "${rke2_cni}"
%{ endif ~}
%{ if rke2_ingress_type != null && rke2_ingress_type != "" && rke2_ingress_type != "cilium" ~}
      ingress-controller: "${rke2_ingress_type}"
%{ endif ~}
%{ if !rke2_ingress_nginx_enabled || !rke2_metrics_server_enabled || rke2_ingress_type == "cilium" ~}
      disable:
%{ if !rke2_ingress_nginx_enabled || rke2_ingress_type == "cilium" ~}
        - rke2-ingress-nginx
%{ endif ~}
%{ if !rke2_metrics_server_enabled ~}
        - rke2-metrics-server
%{ endif ~}
%{ endif ~}
%{ if rke2_kube_proxy_enabled != null && !rke2_kube_proxy_enabled && rke2_cni == "cilium" ~}
      disable-kube-proxy: true
%{ endif ~}

%{ if node_role == "master" && rke2_flannel_iface != null && rke2_flannel_iface != "" && rke2_cni != "cilium" ~}
  - path: /var/lib/rancher/rke2/server/manifests/rke2-canal-config.yaml
    permissions: "0640"
    content: |
      ---
      # Pin the Canal/Flannel VXLAN backend to the private NIC instead of the
      # default-route (public) interface, since only the private network is
      # guaranteed full node-to-node reachability (see providers/ovh/network.tf
      # cluster_private_ingress vs. the narrower public-facing rules).
      #
      # RKE2 has no --flannel-iface server flag (that's k3s-only); the
      # rke2-canal chart's real values key is nested under flannel.iface
      # (confirmed against the packaged chart's values.yaml), applied here
      # via the same HelmChartConfig mechanism RKE2 uses for its own addons.
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: rke2-canal
        namespace: kube-system
      spec:
        valuesContent: |-
          flannel:
            iface: "${rke2_flannel_iface}"
%{ endif ~}

%{ if rke2_cni == "cilium" ~}
  - path: /var/lib/rancher/rke2/server/manifests/rke2-cilium-config.yaml
    permissions: "0640"
    content: |
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: rke2-cilium
        namespace: kube-system
      spec:
        valuesContent: |-
%{ if rke2_kube_proxy_enabled != null && !rke2_kube_proxy_enabled ~}
          kubeProxyReplacement: true
          k8sServiceHost: "localhost"
          k8sServicePort: "6443"
          operator:
            replicas: ${rke2_cilium_operator_replicas}
          externalIPs:
            enabled: true
%{ endif ~}
%{ if rke2_ingress_type == "cilium" ~}
          ingressController:
            enabled: true
            loadbalancerMode: dedicated
%{ endif ~}
%{ if rke2_cilium_hubble_enabled ~}
          hubble:
            enabled: true
            relay:
              enabled: true
            ui:
              enabled: true
%{ endif ~}
%{ if rke2_cilium_l2announcements_enabled ~}
          l2announcements:
            enabled: true
          enableLBIPAM: true

  - path: /var/lib/rancher/rke2/server/manifests/cilium-lb-pool.yaml
    permissions: "0640"
    content: |
      apiVersion: cilium.io/v2alpha1
      kind: CiliumLoadBalancerIPPool
      metadata:
        name: default
      spec:
        blocks:
          - start: ${lb_pool_start}
            stop: ${lb_pool_end}
      ---
      apiVersion: cilium.io/v2alpha1
      kind: CiliumL2AnnouncementPolicy
      metadata:
        name: default
      spec:
        loadBalancerIPs: true
        interfaces:
          - ${network_interface}
%{ endif ~}
%{ endif ~}

  - path: /usr/local/bin/rke2-install.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -e

      RKE2_INSTALL_URL="https://get.rke2.io"
      VERSION="${rke2_version}"

      if [[ "$VERSION" != "latest" ]]; then
        export INSTALL_RKE2_VERSION="$VERSION"
      fi

%{ if !is_first_master ~}
      wait_for_first_master() {
        echo "Waiting for first master endpoint ${first_master_ip}:9345"
        for attempt in $(seq 1 360); do
          if bash -c "</dev/tcp/${first_master_ip}/9345" >/dev/null 2>&1; then
            return 0
          fi
          sleep 5
        done
        echo "Timed out waiting for ${first_master_ip}:9345 after 1800 seconds" >&2
        return 1
      }
%{ endif ~}

      echo "Test if URL install is reachable: $RKE2_INSTALL_URL"
      if ! curl --connect-timeout 5 --max-time 10 -fsSLI "$RKE2_INSTALL_URL" >/dev/null 2>curl_error.log; then
        if grep -qi "SSL certificate problem" curl_error.log; then
          echo "TLS certificate verification failed."
          echo "Your network may be intercepting HTTPS traffic."
        fi
        cat curl_error.log
        exit 1
      fi

      echo "Installing RKE2: ${node_role}"
%{ if !is_first_master ~}
      wait_for_first_master
%{ endif ~}

%{ if node_role == "master" ~}
      curl -sfL https://get.rke2.io | sh -
      systemctl enable rke2-server
      systemctl start --no-block rke2-server
%{ else ~}
      curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE="agent" sh -
      systemctl enable rke2-agent
      systemctl start --no-block rke2-agent
%{ endif ~}


%{ if ansible_pull_repo != null && ansible_pull_repo != "" ~}
  - path: /usr/local/bin/run-ansible-pull.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -e

      LOG_FILE="/var/log/ansible-pull.log"
      exec > >(tee -a "$LOG_FILE") 2>&1

      echo "=== $(date) Starting ansible-pull ==="

      if ! command -v $HOME/.local/bin/ansible-pull >/dev/null 2>&1; then
        curl -Ls https://astral.sh/uv/install.sh | sh
        $HOME/.local/bin/uv tool install ansible-core==2.20.0 
      fi

      %{ if ansible_pull_token != null && ansible_pull_token != "" ~}
      REPO_URL="https://${ansible_pull_token}@${ansible_pull_repo}"
      %{ else ~}
      REPO_URL="https://${ansible_pull_repo}"
      %{ endif ~}

      $HOME/.local/bin/uv tool run --from ansible-core ansible-pull \
          -U "$REPO_URL" \
          -C "${ansible_pull_branch}" \
          -i localhost, \
          "${ansible_pull_playbook}" \
          --accept-host-key

      echo "=== $(date) Finished ansible-pull ==="

%{ if ansible_pull_timer != null && ansible_pull_timer != "" ~}
  - path: /etc/systemd/system/ansible-pull.service
    content: |
      [Unit]
      Description=Run Ansible Pull

      [Service]
      ExecStart=/usr/local/bin/run-ansible-pull.sh
  - path: /etc/systemd/system/ansible-pull.timer
    content: |
      [Unit]
      Description=Run Ansible Pull every ${ansible_pull_timer}

      [Timer]
      OnBootSec=5min
      OnUnitActiveSec=${ansible_pull_timer}

      [Install]
      WantedBy=timers.target
  - path: /etc/logrotate.d/ansible-pull
    permissions: "0644"
    content: |
      /var/log/ansible-pull.log {
          daily
          rotate 7
          compress
          missingok
          notifempty
          copytruncate
      }
%{ endif ~}
%{ endif ~}

# --- Disk setup ---
%{ if length(extra_disks) > 0 }
  - path: /usr/local/bin/disk-setup.sh
    permissions: "0750"
    content: |
      #!/bin/bash
      set -e

      echo "Setting up extra disks..."
      sleep 5  # wait for libvirt devices

%{ for d in extra_disks ~}
      if [ -b "/dev/disk/by-id/wwn-${d.wwn}" ]; then
        echo "Formatting ${d.mount_path} with ${d.filesystem} on WWN ${d.wwn}"
        mkfs.${d.filesystem} -F /dev/disk/by-id/wwn-${d.wwn}
        mkdir -p ${d.mount_path}
        mount /dev/disk/by-id/wwn-${d.wwn} ${d.mount_path}
      else
        echo "Disk with WWN ${d.wwn} not found, skipping ${d.mount_path}"
      fi
%{ endfor ~}
%{ endif }

runcmd:
%{ if length(extra_disks) > 0 ~}
  - [ /usr/local/bin/disk-setup.sh ]
%{ endif ~} 
  - [ sysctl, --system ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, qemu-guest-agent.service ]
  - [ systemctl, start, --no-block, qemu-guest-agent.service ]
  - [ domainname, ${domain} ]
%{ if length(nfs_client_mounts) > 0 ~}
  # cloud-init's own `mounts` module runs (and would fail) before packages
  # are installed on this image, so the fstab entry and mount are handled
  # entirely here instead, after nfs-common is guaranteed to be present.
  - [ apt-get, update, -qq ]
  - [ env, DEBIAN_FRONTEND=noninteractive, apt-get, install, -y, nfs-common ]
%{ for m in nfs_client_mounts ~}
  - [ mkdir, -p, "${m.mount_path}" ]
  - [ bash, -c, "grep -qF ${m.mount_path} /etc/fstab || echo '${m.server}:${m.export_path} ${m.mount_path} nfs ${m.options}${m.read_only ? ",ro" : ""} 0 0' >> /etc/fstab" ]
%{ endfor ~}
  - [ mount, -a ]
%{ endif ~}
  - [ /usr/local/bin/rke2-install.sh ]
%{ if ansible_pull_repo != null && ansible_pull_repo != "" ~}
  - [ /usr/local/bin/run-ansible-pull.sh ]
%{ if ansible_pull_timer != null && ansible_pull_timer != "" ~}
  - [ systemctl, enable, --now, ansible-pull.timer ]
%{ endif ~}
%{ endif ~}

final_message: "RKE2 node ${hostname} ready after $UPTIME seconds"
