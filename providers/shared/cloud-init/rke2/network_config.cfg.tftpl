network:
  version: 2
  ethernets:
    ${interface_id}:
      match:
        name: "${interface_match_name}"
%{ if try(interface_optional, false) ~}
      optional: true
%{ endif ~}
%{ if use_dhcp ~}
      dhcp4: true
%{ if !accept_dhcp_routes || !accept_dhcp_dns ~}
      dhcp4-overrides:
%{ if !accept_dhcp_routes ~}
        use-routes: false
%{ endif ~}
%{ if !accept_dhcp_dns ~}
        use-dns: false
%{ endif ~}
%{ endif ~}
%{ else ~}
      dhcp4: false
      addresses:
        - ${ip_address}/${cidr_prefix}
%{ endif ~}
%{ if network_gateway != null && network_gateway != "" ~}
      routes:
        - to: default
          via: ${network_gateway}
%{ else ~}
%{ if try(emit_empty_routes, false) ~}
      routes: []
%{ endif ~}
%{ endif ~}
%{ if dns_servers != null && dns_servers != "" ~}
      nameservers:
        addresses: [${dns_servers}]
        search: [${domain}]
%{ endif ~}
