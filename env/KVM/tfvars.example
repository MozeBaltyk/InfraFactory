cluster = {
  id                  = "factory"
  domain              = "lab"
  timezone            = "Europe/Paris"
  username            = "localadmin"
  node_name_format    = "serial" # serial => factory-node01, role => factory-m01/factory-w01
  cloud_init_selected = "k3s" # k3s or rke2 or talos
  factory_root_path   = "/srv"
  package_upgrade_enabled = "false" # Optional
}

infra = {
  masters = {
    count         = 1
    cpu           = 2
    disk_size     = 10
    memory_gb     = 4
    #user_data_enabled = true # Optional
    #mac_addresses = []  # Optionnal 
    #ip_addresses = []   # Optionnal 
    #extra_disks = [
    #  { size_gb = 20, mount_path = "/data", filesystem = "ext4", label = "data" },
    #  { size_gb = 2, mount_path = "/logs", filesystem = "ext4", label = "logs" }
    #]
  }
  workers = {
    count         = 0
    cpu           = 2
    disk_size     = 10
    memory_gb     = 4
    #user_data_enabled = true # Optional
    #mac_addresses = []  # Optionnal 
    #ip_addresses = []   # Optionnal 
    #extra_disks = []    # Optionnal 
  }
  vms = {
    count         = 0
    cpu           = 2
    disk_size     = 10
    memory_gb     = 4
    #user_data_enabled = true # Optional; standalone VMs always use shared default cloud-init
    #mac_addresses = []  # Optionnal
    #ip_addresses = []   # Optionnal
  }
}

network = {
  ip_type  = "dhcp"
  mode     = "nat"
  cidr     = "192.168.100.0/24"
  extra_dns = ["8.8.8.8", "8.8.4.4"] # Optional
}

# Bridge with dhcp example
#network = {
#  ip_type = "dhcp"
#  mode    = "bridge"
#  bridge_name = "br0"
#}

