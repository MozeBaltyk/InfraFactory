export OVH_ENDPOINT="ovh-eu"
export OVH_APPLICATION_KEY="xxxxxxxxxxxxxxxx"
export OVH_APPLICATION_SECRET="xxxxxxxxxxxxxxxx"
export OVH_CONSUMER_KEY="xxxxxxxxxxxxxxxx"
export TF_VAR_ovh_project_service_name="xxxxxxxxxxxxxxxx"

# Dedicated OVH Object Storage S3 user for OpenTofu state.
export AWS_ACCESS_KEY_ID="xxxxxxxxxxxxxxxx"
export AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxx"

# Optional, only when a cluster or bastion configures ansible.pull for a private repository.
# export TF_VAR_ansible_pull_token="xxxxxxxxxxxxxxxx"
