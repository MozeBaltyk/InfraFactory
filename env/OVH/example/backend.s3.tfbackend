# Copy to env/OVH/<project>/backend.s3.tfbackend. No credentials belong here.
# `key` and `workspace_key_prefix` are injected per stack (clusters vs bastion)
# by scripts/ovh-backend.sh, so keep them absent from this shared file.
bucket = "<project-state-bucket>"
region = "gra"

endpoints = {
  s3 = "https://s3.gra.io.cloud.ovh.net"
}

use_lockfile                 = true
encrypt                      = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true