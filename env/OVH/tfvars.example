ovh_endpoint           = "ovh-eu"
ovh_application_key    = "xxxxxxxxxxxxxxxx"
ovh_application_secret = "xxxxxxxxxxxxxxxx"
ovh_consumer_key       = "xxxxxxxxxxxxxxxx"
ovh_project_service_name = "xxxxxxxxxxxxxxxx"

cluster = {
  id                      = "factory"
  domain                  = "lab"
  timezone                = "Europe/Paris"
  region                  = "GRA9"
  username                = "localadmin"
  node_name_format        = "serial" # serial => factory-node01, role => factory-m01/factory-w01
  cloud_init_selected     = "k3s"
}

infra = {
  masters = {
    count = 1 # Can be >1; set network.private_cidr for multi-master/private join
    # instance_size = "b2-7"
    # disk_size     = 40 # custom root disk sizing not supported yet
    # extra_disks = [    # not supported yet
    #   { size_gb = 20, mount_path = "/data", filesystem = "ext4", label = "data" }
    # ]
  }

  workers = {
    count = 0 # Workers are supported
    # instance_size = "b2-7"
    # disk_size     = 40 # custom root disk sizing not supported yet
    # extra_disks   = []  # not supported yet
  }
}

os = {
  selected = "ubuntu24"
}

###
### Optional network configuration
### 

# Minimal
# network = {}

# With private network
# network = {
#   private = {
#     cidr = "10.0.0.0/24"
#   }
# }

# With private network only (default endpoint = first master public IP)
# network = {
#   private = {
#     cidr = "10.0.0.0/24"
#   }
# }

# With Load Balancer for the Kubernetes API (endpoint = LB floating IP)
# Flavors: small, medium, large, xl
# network = {
#   private = {
#     cidr = "10.0.0.0/24"
#   }
# 
#   kube_api = {
#     endpoint = "lb_ip"
# 
#     load_balancer = {
#       enabled = true
#       flavor  = "small"
#     }
#   }
# }

# DNS mode (LB is still created but endpoint is set to an external DNS name)
# network = {
#   private = {
#     cidr = "10.0.0.0/24"
#   }
# 
#   kube_api = {
#     endpoint = "dns"
# 
#     dns = {
#       name = "kube.example.com"
#     }
# 
#     load_balancer = {
#       enabled = true
#       flavor  = "small"
#     }
#   }
# }


