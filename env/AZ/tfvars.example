azure_subscription_id = "xxxxxxxxxxxxxxxxxx"
azure_client_id       = "xxxxxxxxxxxxxxxxxx"
azure_client_secret   = "xxxxxxxxxxxxxxxxxx"
azure_tenant_id       = "xxxxxxxxxxxxxxxxxx"

cluster = {
  id                      = "factory"
  domain                  = "lab"
  timezone                = "Europe/Paris"
  region                  = "westeurope"
  username                = "localadmin"
  cloud_init_selected     = "k3s"
  package_upgrade_enabled = false # Optional
}

infra = {
  masters = {
    count = 1
    # instance_size = "Standard_D2s_v5"
    # disk_size     = 40
    # user_data_enabled = true
    # extra_disks = [
    #   { size_gb = 20, mount_path = "/data", filesystem = "ext4", label = "data" }
    # ]
  }

  workers = {
    count = 0
    # instance_size = "Standard_D2s_v5"
    # disk_size     = 40
    # user_data_enabled = true
    # extra_disks   = []
  }

  # Standalone non-Kubernetes VMs. Use with cloud_init_selected = "default"
  # for VM-only deployments, or alongside masters/workers when extra hosts are needed.
  vms = {
    count = 0
    # instance_size = "Standard_D2s_v5"
    # disk_size     = 40
    # user_data_enabled = true
    # extra_disks   = []
  }
}

os = {
  selected = "ubuntu24"
}

# Optional override; if omitted, provider defaults are used.
#network = {
#  cidr         = "192.168.100.0/24"
#  subnet_index = 0
#  ip_type      = "dhcp"
#}

nsg_rules = {
  ssh = {
    port           = 22
    name           = "Allow_SSH"
    description    = "SSH access from admin IP"
    source_address = "" # Empty = autodetect current public IP during apply
  }
  k8s_api = {
    port           = 6443
    name           = "Allow_K8S_API"
    description    = "Kubernetes API access from admin IP"
    source_address = "" # Or set a fixed trusted CIDR like x.x.x.x/32
  }
}

