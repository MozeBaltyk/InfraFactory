[private]
_scaffold:
    #!/usr/bin/env bash
    set -euo pipefail

    just _require-provider

    dir="$(just _tf-dir)"
    mkdir -p "$dir"

    tmp="$(mktemp)"
    cat > "$tmp" <<'YAML'
    apiVersion: kustomize.config.k8s.io/v1beta1
    kind: Kustomization

    resources:
      - terraform.yaml
    YAML
    mv "$tmp" "$dir/kustomization.yaml"

    resource="$(just _terraform-name)"
    secret="$(just _tfvars-secret-name)"
    output="$(just _terraform-output-secret)"
    module="$(just _provider-module-path)"
    ssh_secret="$(just _libvirt-ssh-secret-name)"
    if [ "{{ PROVIDER }}" = "KVM" ]; then
      just _require-kvm-libvirt-remote
    fi

    tmp="$(mktemp)"
    cat > "$tmp" <<YAML
    apiVersion: infra.contrib.fluxcd.io/v1alpha2
    kind: Terraform
    metadata:
      name: $resource
      namespace: flux-system
    spec:
      interval: 10m
      workspace: {{ ENV }}
      path: $module
    YAML

    if [ "{{ PROVIDER }}" = "KVM" ]; then
      cat >> "$tmp" <<YAML
      runnerPodTemplate:
        spec:
          image: {{ TOFU_RUNNER_IMAGE }}
    YAML
    fi

    cat >> "$tmp" <<YAML
      sourceRef:
        kind: GitRepository
        name: flux-system
        namespace: flux-system
      backendConfig:
        secretSuffix: $resource
      fileMappings:
        - location: workspace
          path: terraform.auto.tfvars
          secretRef:
            name: $secret
            key: terraform.tfvars
    YAML

    if [ "{{ PROVIDER }}" = "KVM" ]; then
      cat >> "$tmp" <<YAML
        - location: home
          path: .ssh/id_rsa
          secretRef:
            name: $ssh_secret
            key: id_rsa
        - location: home
          path: .ssh/config
          secretRef:
            name: $ssh_secret
            key: config
    YAML
    fi

    cat >> "$tmp" <<YAML
      writeOutputsToSecret:
        name: $output
    YAML
    mv "$tmp" "$dir/terraform.yaml"

    just _ensure-provider-kustomization
    just log ok "Scaffolded tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}" "path" "$(just _tf-dir)"

[private]
_init-tfvars:
    @just _require-provider
    @tfvars="$(just _provider-tfvars-src)"; \
      if [ -f "$tfvars" ]; then \
        just log ok "GitOps tfvars already exists" "path" "$tfvars"; \
        exit 0; \
      fi; \
      mkdir -p "$(dirname "$tfvars")"; \
      if [ -f "$(just _provider-local-tfvars)" ]; then \
        cp "$(just _provider-local-tfvars)" "$tfvars"; \
        just log ok "Initialized GitOps tfvars from local env" "src" "$(just _provider-local-tfvars)" "dst" "$tfvars"; \
      else \
        cp "$(just _provider-example-tfvars)" "$tfvars"; \
        just log ok "Initialized GitOps tfvars from example" "src" "$(just _provider-example-tfvars)" "dst" "$tfvars"; \
      fi; \
      if [ "{{ PROVIDER }}" = "KVM" ] && ! grep -q '^gitops_artifacts_mode[[:space:]]*=' "$tfvars"; then \
        printf '\n# GitOps mode exposes provider artifacts as Terraform outputs for tofu-controller.\ngitops_artifacts_mode = "gitops"\n' >> "$tfvars"; \
      fi

[private]
_ensure-provider-kustomization:
    @just _require-provider
    @provider_dir="$(just _tf-provider-dir)"; \
      mkdir -p "$provider_dir"; \
      if [ ! -f "$provider_dir/kustomization.yaml" ]; then \
        tmp="$(mktemp)"; \
        printf '%s\n' \
          'apiVersion: kustomize.config.k8s.io/v1beta1' \
          'kind: Kustomization' \
          'resources: []' > "$tmp"; \
        mv "$tmp" "$provider_dir/kustomization.yaml"; \
      fi

[private]
_set-provider-resource resource present:
    @provider_kustomization="$(just _tf-provider-kustomization)"; \
      python3 -c $'import sys\nfrom pathlib import Path\npath = Path(sys.argv[1])\nresource = sys.argv[2]\npresent = sys.argv[3] == "true"\ntext = path.read_text() if path.exists() else ""\nlines = text.splitlines()\nstart = None\nend = None\nfor index, line in enumerate(lines):\n    if line.strip() == "resources:" or line.strip() == "resources: []":\n        start = index\n        end = index + 1\n        if line.strip() == "resources:":\n            while end < len(lines):\n                stripped = lines[end].strip()\n                if lines[end].startswith((" ", "\\t")) or stripped == "" or stripped.startswith("#"):\n                    end += 1\n                else:\n                    break\n        break\nresources = []\nkept = []\nif start is not None and lines[start].strip() == "resources:":\n    for line in lines[start + 1:end]:\n        stripped = line.strip()\n        if stripped.startswith("- "):\n            item = stripped[2:].strip()\n            if item and item not in resources:\n                resources.append(item)\n        elif stripped == "" or stripped.startswith("#"):\n            kept.append(line)\nif present and resource not in resources:\n    resources.append(resource)\nif not present:\n    resources = [item for item in resources if item != resource]\nblock = ["resources:"] + kept + [f"  - {item}" for item in resources] if resources or kept else ["resources: []"]\nif start is None:\n    if lines and lines[-1].strip() != "":\n        lines.append("")\n    new_lines = lines + block\nelse:\n    new_lines = lines[:start] + block + lines[end:]\npath.write_text("\\n".join(new_lines).rstrip() + "\\n")' "$provider_kustomization" "{{ resource }}" "{{ present }}"

[doc('Activate selected tf overlay in Flux tree')]
[group('Overlay')]
activate:
    @just title "Activate tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @just _require-provider
    @dir="$(just _tf-dir)"; \
      [ -f "$dir/terraform.yaml" ] || just log fatal "Missing scaffold" "path" "$dir"
    @just _ensure-provider-kustomization
    @just _set-provider-resource ./{{ ENV }} true
    @just log ok "Activated tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"

[doc('Deactivate selected tf overlay from Flux tree')]
[group('Overlay')]
deactivate:
    @just title "Deactivate tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @just _require-provider
    @just _ensure-provider-kustomization
    @just _set-provider-resource ./{{ ENV }} false
    @just log ok "Deactivated tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"

[doc('List scaffolded tf overlays and activation status')]
[group('Overlay')]
list:
    @root="{{ TF_GITOPS_ROOT }}"; \
      for provider in KVM AZ OVH; do \
        provider_dir="$root/$provider"; \
        provider_kustomization="$provider_dir/kustomization.yaml"; \
        [ -d "$provider_dir" ] || continue; \
        for env_dir in "$provider_dir"/*; do \
          [ -d "$env_dir" ] || continue; \
          [ -f "$env_dir/terraform.yaml" ] || continue; \
          env_name="$(basename "$env_dir")"; \
          if [ -f "$provider_kustomization" ] && grep -Fxq "  - ./$env_name" "$provider_kustomization"; then \
            status='active'; \
          else \
            status='inactive'; \
          fi; \
          manifest="$env_dir/terraform.yaml"; \
          runner="$(just _manifest-runner-image "$manifest")"; \
          source_ref="$(just _manifest-source-ref "$manifest")"; \
          printf '%-4s %-12s %-8s runner=%s source=%s repo=%s\n' "$provider" "$env_name" "$status" "$runner" "$source_ref" "$(just _flux-instance-source)"; \
        done; \
      done

[doc('Sync selected tfvars as cluster-local Secret, not Flux-managed')]
[group('Secrets')]
sync-tfvars:
    @just _require-provider
    @just _require-tfvars
    @just log info "Syncing cluster-local tfvars Secret" "namespace" "flux-system" "secret" "$(just _tfvars-secret-name)" "gitops" "not Flux-managed"
    @if [ "{{ PROVIDER }}" = "AZ" ] || [ "{{ PROVIDER }}" = "OVH" ]; then \
        just log warn "Cloud tfvars may contain credentials" "provider" "{{ PROVIDER }}" "action" "do not commit plaintext secrets" "sync" "imperative cluster-local Secret for now"; \
      fi
    @kubectl -n flux-system create secret generic $(just _tfvars-secret-name) --from-file=terraform.tfvars=$(just _provider-tfvars-src) --dry-run=client -o yaml | kubectl apply -f -
    @just log ok "Synced cluster-local tfvars Secret" "namespace" "flux-system" "secret" "$(just _tfvars-secret-name)" "gitops" "not Flux-managed"

[doc('Check configured KVM libvirt SSH connectivity')]
[group('Checks')]
check-libvirt-ssh:
    @just title "Check libvirt SSH connectivity" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @just _require-provider
    @if [ "{{ PROVIDER }}" != "KVM" ]; then just log info "Skipping libvirt ssh connectivity check" "provider" "{{ PROVIDER }}"; exit 0; fi
    @just _require-kvm-libvirt-remote
    @key_src="$(just _libvirt-key-src)"; \
      target="$(just _libvirt-target)"; \
      test -f "$key_src" || just log fatal "Missing libvirt key" "path" "$key_src"; \
      IFS=$'\t' read -r _ ssh_user ssh_host ssh_port <<< "$target"; \
      ssh_opts=(-i "$key_src" -p "$ssh_port" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null); \
      just log info "Checking libvirt ssh connectivity" "user" "$ssh_user" "host" "$ssh_host" "port" "$ssh_port" "key" "$key_src"; \
      ssh "${ssh_opts[@]}" "$ssh_user@$ssh_host" true || \
        just log fatal "Libvirt ssh connectivity check failed" "user" "$ssh_user" "host" "$ssh_host" "port" "$ssh_port" "key" "$key_src"; \
      just log ok "Libvirt ssh connectivity check succeeded" "user" "$ssh_user" "host" "$ssh_host" "port" "$ssh_port"; \
      uri="qemu+ssh://$ssh_user@$ssh_host:$ssh_port/system?keyfile=$key_src&no_verify=1&no_tty=1"; \
      just log info "List remote libvirt VMs" "target" "$ssh_user@$ssh_host:$ssh_port"; \
      printf 'libvirt_uri=%s\n' "$uri"; \
      virsh -c "$uri" list --all || \
        just log fatal "Provider-style qemu/libvirt URI check failed" "key" "$key_src" "hint" "ensure local virsh is available, SSH key path is readable, and the remote SSH user has libvirt/qemu permissions"; \
      just log ok "Provider-style qemu/libvirt access check succeeded" "target" "$ssh_user@$ssh_host:$ssh_port"

[doc('Sync libvirt host SSH secret from LIBVIRT_HOST_KEY_PATH or $HOME/.ssh/ed25519')]
[group('Secrets')]
sync-libvirt-ssh:
    @just _require-provider
    @if [ "{{ PROVIDER }}" != "KVM" ]; then just log info "Skipping libvirt ssh secret" "provider" "{{ PROVIDER }}"; exit 0; fi
    @just check-libvirt-ssh
    @test -f "$(just _libvirt-key-src)" || just log fatal "Missing libvirt key" "path" "$(just _libvirt-key-src)"
    @ssh_config_file="$(mktemp)"; \
      printf '%s\n' 'Host *' '  StrictHostKeyChecking no' '  UserKnownHostsFile /dev/null' '  IdentityFile ~/.ssh/id_rsa' > "$ssh_config_file"; \
      kubectl -n flux-system create secret generic $(just _libvirt-ssh-secret-name) \
        --from-file=id_rsa=$(just _libvirt-key-src) \
        --from-file=config="$ssh_config_file" \
        --dry-run=client -o yaml | kubectl apply -f -; \
      rm -f "$ssh_config_file"
    @just log ok "Synced cluster-local libvirt SSH Secret" "namespace" "flux-system" "secret" "$(just _libvirt-ssh-secret-name)" "gitops" "not Flux-managed"

[doc('Scaffold selected tf overlay and sync cluster-local secrets')]
[group('Overlay')]
prepare:
    @just title "Prepare tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @tfvars_source="$(just _tfvars-source)"; \
      just _prepare-context; \
      just _init-tfvars; \
      just _scaffold; \
      just _bootstrap-secret-notice; \
      just sync-tfvars; \
      if [ "{{ PROVIDER }}" = "KVM" ]; then just sync-libvirt-ssh; fi; \
      just _target-summary; \
      if [ "$tfvars_source" = "example" ]; then \
        just log warn "Cluster-local tfvars Secret was synced from an example/template" "secret" "$(just _tfvars-secret-name)" "tfvars" "$(just _provider-tfvars-src)" "action" "review and update before relying on it"; \
      fi; \
      just log ok "Prepared tf overlay" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"

[doc('Reconcile Flux root and tf overlays')]
[group('Operations')]
reconcile:
    @just title "Reconcile Flux and tf overlays" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @just _require-provider
    @just log info "Assumes scaffold and activation are committed and pushed"
    @flux reconcile source git flux-system -n flux-system
    @flux reconcile kustomization flux-system -n flux-system --with-source
    @flux reconcile kustomization tf-controller -n flux-system --with-source
    @just log ok "Reconciled Flux and tf overlays" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"

[doc('Show Terraform resource, outputs, state secrets, and locks')]
[group('Operations')]
status:
    @just title "Show tf overlay status" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"
    @just _require-provider
    @provider_kustomization="$(just _tf-provider-kustomization)"; \
      if [ -f "$provider_kustomization" ] && grep -Fxq "  - ./{{ ENV }}" "$provider_kustomization"; then status='active'; else status='inactive'; fi; \
      just log info "Overlay activation" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}" "status" "$status"
    @manifest="$(just _terraform-manifest)"; \
      just log info "Manifest runner image" "image" "$(just _manifest-runner-image "$manifest")"; \
      just log info "Manifest source" "sourceRef" "$(just _manifest-source-ref "$manifest")" "repo" "$(just _flux-instance-source)"; \
      just log info "Live runner image" "image" "$(just _live-terraform-runner-image)"; \
      just log info "Live source" "source" "$(just _live-terraform-source)"
    @kubectl -n flux-system get terraform $(just _terraform-name) -o wide --ignore-not-found=true
    @kubectl -n flux-system get secret $(just _terraform-output-secret) --ignore-not-found=true
    @kubectl -n flux-system get secret $(just _terraform-state-secret) $(just _terraform-default-state-secret) --ignore-not-found=true
    @kubectl -n flux-system get lease $(just _terraform-lock-name) $(just _terraform-default-lock-name) --ignore-not-found=true
    @just log ok "Displayed tf overlay status" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"

