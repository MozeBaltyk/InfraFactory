set positional-arguments := true
set quiet := true
set shell := ['bash', '-euo', 'pipefail', '-c']

mod runner_image "runner/mod.justfile"

PROVIDER := env_var_or_default("PROVIDER", "KVM")
ENV := env_var_or_default("ENV", "lab")
TF_GITOPS_ROOT := "./flux/tf"
TARGET_NAMESPACE := env_var_or_default("TARGET_NAMESPACE", "flux-system")
TOFU_RUNNER_IMAGE := env_var_or_default("TOFU_RUNNER_IMAGE", "registry-zot.flux-system.svc.cluster.local:5000/infrafactory/tf-runner-libvirt:v0.16.2-homefix")

[private]
default:
    just -l

[private]
_require-provider:
    @just _require-env
    case "{{ PROVIDER }}" in KVM|AZ|OVH) ;; *) just log fatal "Unsupported provider" "provider" "{{ PROVIDER }}" ;; esac

[private]
_require-env:
    @env_name='{{ ENV }}'; \
      if [[ ! "$env_name" =~ ^[A-Za-z0-9_-]+$ ]]; then \
        just log fatal "Unsafe ENV value" "env" "$env_name" "hint" "Use only letters, numbers, underscore, and dash"; \
      fi

[private]
_provider-lower:
    @case "{{ PROVIDER }}" in AZ) echo az ;; KVM) echo kvm ;; OVH) echo ovh ;; *) exit 1 ;; esac

[private]
_provider-module-path:
    @case "{{ PROVIDER }}" in KVM) echo ./providers/libvirt ;; AZ) echo ./providers/azure ;; OVH) echo ./providers/ovh ;; *) exit 1 ;; esac

[private]
_provider-tfvars-src:
    @case "{{ PROVIDER }}" in AZ) echo ./flux/tf/AZ/{{ ENV }}/{{ ENV }}.tfvars ;; KVM) echo ./flux/tf/KVM/{{ ENV }}/{{ ENV }}.tfvars ;; OVH) echo ./flux/tf/OVH/{{ ENV }}/{{ ENV }}.tfvars ;; *) exit 1 ;; esac

[private]
_provider-example-tfvars:
    @case "{{ PROVIDER }}" in AZ) echo ../env/AZ/tfvars.example ;; KVM) echo ../env/KVM/tfvars.example ;; OVH) echo ../env/OVH/tfvars.example ;; *) exit 1 ;; esac

[private]
_provider-local-tfvars:
    @case "{{ PROVIDER }}" in AZ) echo ../env/AZ/{{ ENV }}.tfvars ;; KVM) echo ../env/KVM/{{ ENV }}.tfvars ;; OVH) echo ../env/OVH/{{ ENV }}.tfvars ;; *) exit 1 ;; esac

[private]
_tfvars-source:
    @just _require-provider
    @tfvars="$(just _provider-tfvars-src)"; \
      if [ -f "$tfvars" ]; then \
        echo existing; \
      elif [ -f "$(just _provider-local-tfvars)" ]; then \
        echo local; \
      else \
        echo example; \
      fi

[private]
_libvirt-key-src:
    @if [ -n "${LIBVIRT_HOST_KEY_PATH:-}" ]; then echo "${LIBVIRT_HOST_KEY_PATH}"; else echo "$HOME/.ssh/ed25519"; fi

[private]
_tf-dir:
    @printf '%s/%s/%s\n' "{{ TF_GITOPS_ROOT }}" "{{ PROVIDER }}" "{{ ENV }}"

[private]
_terraform-manifest:
    @printf '%s/terraform.yaml\n' "$(just _tf-dir)"

[private]
_manifest-runner-image manifest:
    @if [ ! -f "{{ manifest }}" ]; then \
        echo missing; \
      else \
        python3 -c $'import re\nimport sys\nfrom pathlib import Path\npath = Path(sys.argv[1])\ntext = path.read_text()\nmatch = re.search(r"(?m)^\\s{2}runnerPodTemplate:\\s*$", text)\nif not match:\n    print("controller-default", end="")\n    sys.exit(0)\nlines = text.splitlines()\nstart = next((i for i, line in enumerate(lines) if re.match(r"^\\s{2}runnerPodTemplate:\\s*$", line)), None)\nif start is None:\n    print("controller-default", end="")\n    sys.exit(0)\nfor line in lines[start + 1:]:\n    if line and not line.startswith("    "):\n        break\n    m = re.match(r"^\\s+image:\\s*(.+?)\\s*$", line)\n    if m:\n        print(m.group(1).strip().strip("\\\'\\\""), end="")\n        sys.exit(0)\nprint("controller-default", end="")' "{{ manifest }}"; \
      fi

[private]
_manifest-source-ref manifest:
    @if [ ! -f "{{ manifest }}" ]; then \
        echo missing; \
      else \
        python3 -c $'import re\nimport sys\nfrom pathlib import Path\ntext = Path(sys.argv[1]).read_text()\nlines = text.splitlines()\nstart = next((i for i, line in enumerate(lines) if re.match(r"^\\s{2}sourceRef:\\s*$", line)), None)\nvalues = {}\nif start is not None:\n    for line in lines[start + 1:]:\n        if line and not line.startswith("    "):\n            break\n        m = re.match(r"^\\s+(kind|name|namespace):\\s*(.+?)\\s*$", line)\n        if m:\n            values[m.group(1)] = m.group(2).strip().strip("\\\'\\\"")\nkind = values.get("kind", "unknown")\nname = values.get("name", "unknown")\nnamespace = values.get("namespace", "flux-system")\nprint(f"{kind}/{name} namespace={namespace}", end="")' "{{ manifest }}"; \
      fi

[private]
_flux-instance-source:
    @manifest="./apps/flux-system/flux-instance/app/helmrelease.yaml"; \
      if [ ! -f "$manifest" ]; then echo missing; exit 0; fi; \
      python3 -c $'import re\nimport sys\nfrom pathlib import Path\ntext = Path(sys.argv[1]).read_text()\nvalues = {}\nfor name in ("url", "ref", "path"):\n    m = re.search(rf"(?m)^\\s+{name}:\\s*(.+?)\\s*$", text)\n    values[name] = m.group(1).strip().strip("\\\'\\\"") if m else "unknown"\nprint(f"url={values[\'url\']} ref={values[\'ref\']} path={values[\'path\']}", end="")' "$manifest"

[private]
_live-terraform-runner-image:
    @name="$(just _terraform-name)"; namespace="flux-system"; \
      if ! kubectl -n "$namespace" get terraform "$name" >/dev/null 2>&1; then echo missing; exit 0; fi; \
      image="$(kubectl -n "$namespace" get terraform "$name" -o jsonpath='{.spec.runnerPodTemplate.spec.image}')"; \
      if [ -n "$image" ]; then echo "$image"; else echo controller-default; fi

[private]
_live-terraform-source:
    @name="$(just _terraform-name)"; namespace="flux-system"; \
      if ! kubectl -n "$namespace" get terraform "$name" >/dev/null 2>&1; then echo missing; exit 0; fi; \
      kind="$(kubectl -n "$namespace" get terraform "$name" -o jsonpath='{.spec.sourceRef.kind}')"; \
      source_name="$(kubectl -n "$namespace" get terraform "$name" -o jsonpath='{.spec.sourceRef.name}')"; \
      source_namespace="$(kubectl -n "$namespace" get terraform "$name" -o jsonpath='{.spec.sourceRef.namespace}')"; \
      source_namespace="${source_namespace:-flux-system}"; \
      if [ "$kind" != "GitRepository" ]; then \
        printf '%s/%s namespace=%s' "$kind" "$source_name" "$source_namespace"; \
        exit 0; \
      fi; \
      if ! kubectl -n "$source_namespace" get gitrepository "$source_name" >/dev/null 2>&1; then \
        printf 'GitRepository/%s namespace=%s status=missing' "$source_name" "$source_namespace"; \
        exit 0; \
      fi; \
      url="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.url}')"; \
      branch="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.ref.branch}')"; \
      name_ref="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.ref.name}')"; \
      tag="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.ref.tag}')"; \
      semver="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.ref.semver}')"; \
      commit="$(kubectl -n "$source_namespace" get gitrepository "$source_name" -o jsonpath='{.spec.ref.commit}')"; \
      ref="${branch:-${name_ref:-${tag:-${semver:-${commit:-default}}}}}"; \
      printf 'GitRepository/%s namespace=%s url=%s ref=%s' "$source_name" "$source_namespace" "$url" "$ref"

[private]
_tf-provider-dir:
    @printf '%s/%s\n' "{{ TF_GITOPS_ROOT }}" "{{ PROVIDER }}"

[private]
_tf-provider-kustomization:
    @printf '%s/%s/kustomization.yaml\n' "{{ TF_GITOPS_ROOT }}" "{{ PROVIDER }}"

[private]
_tfvars-secret-name:
    @echo tfvars-$(just _provider-lower)-{{ ENV }}

[private]
_libvirt-ssh-secret-name:
    @echo libvirt-ssh-$(just _provider-lower)-{{ ENV }}

[private]
_terraform-name:
    @echo infra-$(just _provider-lower)-{{ ENV }}

[private]
_terraform-output-secret:
    @echo tf-output-$(just _provider-lower)-{{ ENV }}

[private]
_terraform-state-secret:
    @echo tfstate-{{ ENV }}-$(just _terraform-name)

[private]
_terraform-default-state-secret:
    @echo tfstate-default-$(just _terraform-name)

[private]
_terraform-lock-name:
    @echo lock-tfstate-{{ ENV }}-$(just _terraform-name)

[private]
_terraform-default-lock-name:
    @echo lock-tfstate-default-$(just _terraform-name)

[private]
_manual-libvirt-artifact-secret:
    @echo libvirt-artifacts-$(just _provider-lower)-{{ ENV }}

[private]
_manual-kubeconfig-path:
    @echo ../env/KVM/{{ ENV }}/kubeconfig

[private]
_require-tfvars:
    @test -f "$(just _provider-tfvars-src)" || just log fatal "Missing GitOps tfvars" "path" "$(just _provider-tfvars-src)" "hint" "run just prepare to initialize it"

[private]
_overlay-activation-state:
    @provider_kustomization="$(just _tf-provider-kustomization)"; \
      if [ -f "$provider_kustomization" ] && grep -Fxq "  - ./{{ ENV }}" "$provider_kustomization"; then echo active; else echo inactive; fi

[private]
_libvirt-target:
    @tfvars="$(just _provider-tfvars-src)"; \
      if [ ! -f "$tfvars" ]; then printf 'missing\t%s' "$tfvars"; exit 0; fi; \
      python3 -c $'import re\nimport sys\nfrom pathlib import Path\npath = Path(sys.argv[1])\ntext = path.read_text()\nmatch = re.search(r"(?m)^\\s*libvirt\\s*=\\s*\\{", text)\nif not match:\n    print("local\\tremote=false or missing", end="")\n    sys.exit(0)\nstart = match.end()\ndepth = 1\nend = start\nwhile end < len(text) and depth:\n    char = text[end]\n    if char == "{":\n        depth += 1\n    elif char == "}":\n        depth -= 1\n    end += 1\nbody = text[start:end - 1]\nbody = re.sub(r"(?m)#.*$", "", body)\nbody = re.sub(r"(?m)//.*$", "", body)\ndef value(name):\n    m = re.search(rf"(?m)^\\s*{name}\\s*=\\s*(\\\"(?:[^\\\"\\\\]|\\\\.)*\\\"|\\d+|true|false)\\s*(?:$|\\n)", body)\n    if not m:\n        return ""\n    raw = m.group(1).strip()\n    if raw.startswith("\\\"") and raw.endswith("\\\""):\n        return bytes(raw[1:-1], "utf-8").decode("unicode_escape")\n    return raw\nremote = value("remote").lower()\nif remote != "true":\n    print("local\\tremote=false or missing", end="")\n    sys.exit(0)\nuser = value("user")\nhost = value("host")\nport = value("port") or "22"\nif not user or not host:\n    print("error\\tlibvirt.remote=true requires libvirt.user and libvirt.host", end="")\nelse:\n    print(f"remote\\t{user}\\t{host}\\t{port}", end="")' "$tfvars"

[private]
_require-kvm-libvirt-remote:
    @if [ "{{ PROVIDER }}" != "KVM" ]; then exit 0; fi
    @target="$(just _libvirt-target)"; \
      tfvars="$(just _provider-tfvars-src)"; \
      if [[ "$target" == remote$'\t'* ]]; then \
        exit 0; \
      fi; \
      detail="libvirt.remote=false or missing"; \
      if [[ "$target" == missing$'\t'* ]]; then \
        detail="missing GitOps tfvars: ${target#missing$'\t'}"; \
      elif [[ "$target" == error$'\t'* ]]; then \
        detail="${target#error$'\t'}"; \
      fi; \
      just log fatal "KVM GitOps requires libvirt.remote=true" "tfvars" "$tfvars" "detail" "$detail" "reason" "tofu-controller runs in a Kubernetes runner pod, so qemu:///system would target the pod/container, not the libvirt host" "hint" "set libvirt.remote=true plus libvirt.user, libvirt.host, and libvirt.port in $tfvars"

[private]
_target-summary:
    @just _require-provider
    @state="$(just _overlay-activation-state)"; \
      just title "GitOps Terraform target summary" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"; \
      just log info "Target" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}"; \
      just log info "Overlay" "dir" "$(just _tf-dir)" "terraform_manifest" "$(just _terraform-manifest)"; \
      just log info "Terraform CR" "name" "$(just _terraform-name)" "namespace" "flux-system"; \
      just log info "Runner image" "manifest" "$(just _manifest-runner-image $(just _terraform-manifest))" "live" "$(just _live-terraform-runner-image)"; \
      just log info "Terraform source" "sourceRef" "$(just _manifest-source-ref $(just _terraform-manifest))" "repo" "$(just _flux-instance-source)"; \
      just log info "Module" "path" "$(just _provider-module-path)" "workspace" "{{ ENV }}"; \
      just log info "Provider kustomization" "path" "$(just _tf-provider-kustomization)" "state" "$state"; \
      just log info "Inputs" "tfvars" "$(just _provider-tfvars-src)" "tfvars_secret" "$(just _tfvars-secret-name)"; \
      just log info "Outputs and backend" "output_secret" "$(just _terraform-output-secret)" "state_secret" "$(just _terraform-state-secret)" "default_state_secret" "$(just _terraform-default-state-secret)" "lock" "$(just _terraform-lock-name)" "default_lock" "$(just _terraform-default-lock-name)"; \
      if [ "{{ PROVIDER }}" = "KVM" ]; then \
        target="$(just _libvirt-target)"; \
        if [[ "$target" == remote$'\t'* ]]; then \
          IFS=$'\t' read -r _ ssh_user ssh_host ssh_port <<< "$target"; \
          just log info "KVM libvirt target" "mode" "remote" "target" "$ssh_user@$ssh_host:$ssh_port"; \
          just log info "KVM libvirt SSH" "secret" "$(just _libvirt-ssh-secret-name)" "local_key_source" "$(just _libvirt-key-src)"; \
        elif [[ "$target" == error$'\t'* ]]; then \
          just log warn "KVM libvirt target invalid" "detail" "${target#error$'\t'}" "requirement" "GitOps requires libvirt.remote=true" "hint" "set libvirt user/host/port in $(just _provider-tfvars-src)"; \
        elif [[ "$target" == missing$'\t'* ]]; then \
          just log warn "KVM libvirt target missing" "path" "${target#missing$'\t'}" "requirement" "GitOps requires libvirt.remote=true" "hint" "run prepare and set libvirt user/host/port in $(just _provider-tfvars-src)"; \
        else \
          just log warn "KVM libvirt target is local" "requirement" "GitOps requires libvirt.remote=true" "reason" "tofu-controller runs in a Kubernetes runner pod, so qemu:///system would target the pod/container, not the libvirt host" "hint" "set libvirt user/host/port in $(just _provider-tfvars-src)"; \
        fi; \
      fi; \
      if [ "$state" != "active" ]; then \
        just log warn "Overlay is inactive" "hint" "run PROVIDER={{ PROVIDER }} ENV={{ ENV }} just activate, then commit/push and just reconcile"; \
      fi

[private]
_require-terraform-resource:
    @just _require-provider
    @name="$(just _terraform-name)"; namespace="flux-system"; overlay="$(just _tf-dir)"; \
      if ! resource="$(kubectl -n "$namespace" get terraform "$name" --ignore-not-found=true -o name 2>&1)"; then \
        just log fatal "Kubernetes Terraform check failed" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}" "name" "$name" "namespace" "$namespace" "detail" "$resource" "hint" "check kubeconfig/context, cluster access, and Terraform CRD installation"; \
      fi; \
      if [ -z "$resource" ]; then \
        just log fatal "Terraform CR not found" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}" "name" "$name" "namespace" "$namespace" "overlay" "$overlay" "hint" "Terraform CR is created only after the overlay is active and Flux reconciles; check just list, run activate, commit/push, and reconcile"; \
      fi

[private]
_prepare-context:
    @just _require-provider
    @just log info "Preparing GitOps target" "provider" "{{ PROVIDER }}" "env" "{{ ENV }}" "overlay" "$(just _tf-dir)" "tfvars" "$(just _provider-tfvars-src)" "provider_kustomization" "$(just _tf-provider-kustomization)"

[private]
_bootstrap-secret-notice:
    @just log warn "Cluster-local bootstrap Secret sync" "scope" "tfvars/SSH" "gitops" "not Flux-managed desired state"

[private]
log lvl msg *args:
    @ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"; \
    color=''; reset=''; label='{{ lvl }}'; \
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then \
        reset=$'\033[0m'; \
        case "{{ lvl }}" in \
            info) color=$'\033[36m' ;; \
            ok) color=$'\033[32m' ;; \
            warn) color=$'\033[33m' ;; \
            fatal) color=$'\033[31m' ;; \
        esac; \
    fi; \
    case "{{ lvl }}" in \
        info) label='INFO' ;; \
        ok) label='OK' ;; \
        warn) label='WARN' ;; \
        fatal) label='KO' ;; \
    esac; \
    printf '%s %b[%s]%b %s' "$ts" "$color" "$label" "$reset" "{{ msg }}"; \
    for arg in {{ args }}; do \
        printf ' %s' "$arg"; \
    done; \
    printf '\n'; \
    if [ "{{ lvl }}" = "fatal" ]; then exit 1; fi

[private]
title msg *args:
    @color=''; reset=''; \
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then \
        color=$'\033[36;1m'; reset=$'\033[0m'; \
    fi; \
    printf '\n%b==> %s%b' "$color" "{{ msg }}" "$reset"; \
    for arg in {{ args }}; do \
        printf ' %s' "$arg"; \
    done; \
    printf '\n'

[doc('Apply Kubernetes namespaces')]
_namespaces:
    just log info "Running stage..." "stage" "$0"
    find "./apps" -mindepth 2 -maxdepth 2 -name namespace.yaml | while IFS= read -r namespace_file; do \
        if ! kubectl apply --server-side --field-manager gitops --force-conflicts -f "$namespace_file"; then \
            just log fatal "Failed to apply namespace" "stage" "$0" "path" "$namespace_file"; \
        fi; \
    done

[doc('Apply Helmfile CRDs')]
_crds:
    just log info "Running stage..." "stage" "$0"

    if ! helmfile -f "crds.yaml" template -q | yq -e 'select(.kind == "CustomResourceDefinition")' | kubectl apply --server-side --field-manager bootstrap --force-conflicts -f -; then \
        just log fatal "Failed to apply crds" "stage" "$0"; \
    fi;

[doc('Apply Helmfile Flux')]
_apps:
    just log info "Running stage..." "stage" "$0"
    if ! helmfile -f "flux.yaml" sync --hide-notes; then \
        just log fatal "Failed to sync helmfile" "stage" "$0"; \
    fi

[doc('Deploy Flux and GitOps controllers')]
[group('Deploy')]
deploy:
    @just title "Deploy Flux and GitOps controllers" "namespace" "{{ TARGET_NAMESPACE }}"
    @just _namespaces
    @just _crds
    @just _apps
    @just log ok "Deployed Flux and GitOps controllers" "namespace" "{{ TARGET_NAMESPACE }}"

[doc('Delete Flux')]
[group('Deploy')]
delete:
    @just title "Delete Flux" "namespace" "{{ TARGET_NAMESPACE }}"
    @if [ "${CONFIRM_DELETE:-}" != "flux" ]; then \
        just log fatal "Delete confirmation required" "hint" "rerun with CONFIRM_DELETE=flux"; \
      fi
    @just log info "Running stage..." "stage" "$0"

    # 1. Trigger proper cleanup via operator
    kubectl delete fluxinstance --all -A --ignore-not-found=true

    # 2. Wait until it's really gone
    kubectl wait --for=delete fluxinstance --all -A --timeout=60s || true

    # 3. Now it's safe to remove Helm releases
    helmfile -f "flux.yaml" destroy
    helmfile -f "crds.yaml" destroy

    # 4. Fallback cleanup
    while read -r crd; do \
        kubectl patch "$crd" -p '{"metadata":{"finalizers":[]}}' --type=merge; \
        kubectl delete "$crd"; \
    done < <(kubectl get crd -o name | grep .fluxcd.io)
    @just log ok "Deleted Flux" "namespace" "{{ TARGET_NAMESPACE }}"

[doc('Port-forward Flux UI')]
[group('Deploy')]
forward-ui:
    kubectl -n flux-system port-forward svc/flux-operator 9080:9080

